{
  "name": "@nouns/noun-world-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Noun World (the /world skate game) packaged as a native iOS + Android app with Capacitor.",
  "scripts": {
    "sync-assets": "node scripts/sync-game-assets.mjs",
    "predev": "node scripts/sync-game-assets.mjs",
    "dev": "vite",
    "prebuild": "node scripts/sync-game-assets.mjs",
    "build": "vite build",
    "check": "tsc --noEmit",
    "preview": "vite preview",
    "cap": "cap",
    "cap:sync": "cap sync",
    "android:sync": "pnpm build && cap sync android",
    "android:debug": "pnpm android:sync && cd android && ./gradlew assembleDebug",
    "android:run": "pnpm android:sync && cap run android",
    "android:open": "cap open android",
    "ios:sync": "pnpm build && cap sync ios",
    "ios:open": "cap open ios",
    "clean": "rimraf dist public android/app/build android/.gradle ios/App/public"
  },
  "dependencies": {
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.5.3",
    "@noundry/nouns-assets": "^1.17.2",
    "@nouns/voxel-engine": "workspace:*",
    "n8ao": "1.10.1",
    "partysocket": "^1.1.14",
    "postprocessing": "6.38.3",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-router": "^7.6.2",
    "three": "^0.183.1",
    "three-mesh-bvh": "0.8.3"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/cli": "^8.5.3",
    "@capacitor/ios": "^8.5.3",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@types/three": "^0.183.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.21",
    "postcss": "^8.5.3",
    "rimraf": "^6.0.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.9.2",
    "vite": "^6.3.5"
  }
}
