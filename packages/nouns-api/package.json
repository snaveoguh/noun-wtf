{
  "name": "@nouns/api",
  "version": "0.0.2",
  "private": true,
  "type": "module",
  "scripts": {
    "codegen": "ponder codegen",
    "db": "ponder db",
    "dev": "ponder dev",
    "lint": "eslint .",
    "ponder:push-snapshot": "tar -czf snapshot.tgz .ponder && gh release upload snapshot snapshot.tgz --clobber",
    "ponder:restore-snapshot": "rm -rf .ponder && curl -sL https://github.com/nounsDAO/nouns-monorepo/releases/download/snapshot/snapshot.tgz | tar -xzf -",
    "start": "ponder start",
    "typecheck": "tsc"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.78.0",
    "@noundry/nouns-assets": "1.17.0",
    "@nouns/sdk": "workspace:*",
    "@nouns/vote-permit": "workspace:*",
    "drizzle-orm": "^0.41.0",
    "hono": "^4.5.0",
    "pg": "^8.15.6",
    "ponder": "^0.16.3",
    "sharp": "^0.34.5",
    "viem": "^2.33.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "dotenv": "^16.5.0"
  },
  "engines": {
    "node": ">=18.14"
  }
}
