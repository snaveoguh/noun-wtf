{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "npx pnpm@10 build --filter=@nouns/api"
  },
  "deploy": {
    "startCommand": "npx pnpm@10 --filter @nouns/api -- start --schema $RAILWAY_DEPLOYMENT_ID",
    "healthcheckPath": "/health",
    "healthcheckTimeout": 300
  }
}
