{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile"
  },
  "deploy": {
    "startCommand": "pnpm --filter @nouns/api -- start --schema nouns-prod",
    "healthcheckPath": "/ready",
    "healthcheckTimeout": 600
  }
}
