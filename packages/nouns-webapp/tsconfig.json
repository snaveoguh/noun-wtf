{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "target": "es2020",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "composite": false,
    "declaration": false,
    "forceConsistentCasingInFileNames": true,
    "module": "esnext",
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "types": ["@vitest/browser/providers/playwright"],
    "paths": {
      "@/*": ["./src/*"],
      "@nouns/voxel-engine": ["../voxel-engine/src/index.ts"],
      "@nouns/voxel-engine/*": ["../voxel-engine/*"],
      "@nouns/graffiti": ["../nouns-graffiti/src/index.ts"],
      "@nouns/graffiti/r3f": ["../nouns-graffiti/src/adapters/r3f/index.ts"],
      "@nouns/graffiti/ui": ["../nouns-graffiti/src/ui/index.ts"],
      "@nouns/graffiti/core": ["../nouns-graffiti/src/core/index.ts"]
    },

    "plugins": [
      {
        "name": "@0no-co/graphqlsp",
        "schema": "./src/subgraphs/schema.graphql"
      }
    ],

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src", "src/vite-env.d.ts"]
}
