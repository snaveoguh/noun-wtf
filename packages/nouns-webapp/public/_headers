# SAMEORIGIN, not DENY: noun.wtf frames its own pages (the ice cream van
# page embeds /icecreamvan-scene/). Other sites still can't frame us.
/*
  Content-Security-Policy: upgrade-insecure-requests; frame-ancestors 'self'
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(self), geolocation=()

/stupidfont/manifest.webmanifest
  Content-Type: application/manifest+json

/stupidfont/sw.js
  Cache-Control: no-cache

# Noun World service worker: always revalidated so a deploy's new worker is seen
/world-sw.js
  Cache-Control: no-cache
  Service-Worker-Allowed: /world

/world-app/manifest.webmanifest
  Content-Type: application/manifest+json
  Cache-Control: public, max-age=3600

# Farcaster mini app manifest (README "Farcaster mini app")
/.well-known/farcaster.json
  Content-Type: application/json
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=300
